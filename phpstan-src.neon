includes:
    - phpstan/phpstan-src-baseline.neon

parameters:
    # Required by the auto-installed Laminas extension. The Doctrine objectManagerLoader is deliberately unset: it
    # re-requires bootstrap.php, which redeclares ConsoleRunner and aborts the run.
    laminasframework:
        serviceManagerLoader: phpstan/phpstan-sm-src.php
    level: 5
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
    excludePaths:
        analyseAndScan:
            - src/Kernel.php
    tmpDir: data/cache/phpstan-src
    # PHPStan cannot analyse a subclass of a class it cannot reflect.
    bootstrapFiles:
        - phpstan/stubs/ServiceEntityRepository.php
        - scripts/stubs/symfony-security.php
    ignoreErrors:
        -
            identifier: class.notFound
        -
            identifier: missingType.generics
        -
            message: '#has unknown class .*(Symfony|Doctrine\\Bundle|ApiPlatform)\\.* as its type#'
        -
            message: '#(extends|implements) unknown class .*(Symfony|Doctrine\\Bundle)\\#'
        -
            message: '#Call to method .* on an unknown class .*(Symfony|Doctrine\\Bundle)\\#'
        -
            message: '#Attribute class .*(Symfony|Doctrine\\Bundle)\\.* does not exist#'
        -
            message: '#Instantiated class .*(Symfony|Doctrine\\Bundle)\\.* not found#'
        -
            message: '#used in PHPDoc .* has unknown class#'
