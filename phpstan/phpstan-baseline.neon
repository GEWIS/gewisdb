# Everything the framework switch left behind, so the gate is green and the debt is visible.
#
# The bulk is generics (repositories and collections without their type parameters) and the strictness rules the
# Symfony toolchain brings with it, neither of which the port introduced. Two entries are deliberate: the mailing-list
# comparison in Report\MemberService that never matches (kept because correcting it changes what a regeneration
# writes) and the nullable associations whose properties the application keeps non-null.
#
# Shrink it; do not grow it.
parameters:
	ignoreErrors:
		-
			message: '#^Only booleans are allowed in a negated boolean, mixed given\.$#'
			identifier: booleanNot.exprNotBoolean
			count: 1
			path: ../src/Command/Database/DeleteExpiredMembersCommand.php

		-
			message: '#^Only booleans are allowed in a negated boolean, mixed given\.$#'
			identifier: booleanNot.exprNotBoolean
			count: 1
			path: ../src/Command/Database/MailingListMaintenanceCommand.php

		-
			message: '#^Only booleans are allowed in a negated boolean, mixed given\.$#'
			identifier: booleanNot.exprNotBoolean
			count: 1
			path: ../src/Command/Database/MailingListSyncCommand.php

		-
			message: '#^Method App\\Controller\\Database\\DecisionController\:\:memberFunctionForm\(\) return type with generic interface Symfony\\Component\\Form\\FormInterface does not specify its types\: TData$#'
			identifier: missingType.generics
			count: 1
			path: ../src/Controller/Database/DecisionController.php

		-
			message: '#^If condition is always true\.$#'
