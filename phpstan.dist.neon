includes:
    - phpstan-baseline.neon
    # Ready-made lists of calls that should never reach production: eval and friends, shelling out, weak hashing and
    # randomness, and loose comparisons in in_array()/array_search().
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon

parameters:
    level: 8
    # Extra checks that are not tied to a level, as GEWISWEB runs them.
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true
    # Runtime guards check what the native signature allows, not what a docblock promises.
    treatPhpDocTypesAsCertain: false
    paths:
        - bin
        - config
        - public
        - src
        - tests
    excludePaths:
        # Regenerated by the framework on every container build.
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php

    # A ratchet rather than a baseline: the percentages are global, so a baseline entry stops matching the moment any
    # file is added or removed. Raise these as the gaps are closed; never lower them.
    type_coverage:
        param_type: 98
        return_type: 99
        property_type: 99
        constant_type: 0

    disallowedFunctionCalls:
        -
            function:
                - 'dd()'
                - 'dump()'
                - 'print_r()'
                - 'var_dump()'
                - 'var_export()'
            message: 'leftover debugging; use the profiler or a logger instead'
