{
    "name": "gewis/gewisdb",
    "description": "GEWIS Database management",
    "license": "GPL-3.0",
    "type": "project",
    "keywords": [
        "members",
        "decisions",
        "gewis"
    ],
    "homepage": "http://gewis.nl/",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-ldap": "*",
        "ext-pdo_pgsql": "*",
        "api-platform/doctrine-orm": "^4.3.17",
        "api-platform/symfony": "^4.3.17",
        "cweagans/composer-patches": "^2.0.0",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.7",
        "dragonmantank/cron-expression": "^3.6",
        "fortawesome/font-awesome": "^7.3.1",
        "nelmio/cors-bundle": "^2.6.1",
        "nelmio/security-bundle": "*",
        "phlak/semver": "^6.1",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.3",
        "sensiolabs/typescript-bundle": "^0.2.2",
        "stripe/stripe-php": "^20.0",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11.0",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/ldap": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/password-hasher": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.4.0",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-live-component": "^2.30",
        "symfony/ux-twig-component": "^2.30",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/sass-bundle": "^0.10.0",
        "twbs/bootstrap": "^5.3.8",
        "twig/extra-bundle": "^3.24.0",
        "twig/intl-extra": "^3.26.0",
        "twig/twig": "^3.28.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "fakerphp/faker": "^1.24.1",
        "gewis/gewisphp-coding-standards": "2.1.1",
        "igor-php/igor-php": "^0.8.9",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^12.0.0",
        "spaze/phpstan-disallowed-calls": "^4.6",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^8.1.2",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "patches": {
            "doctrine/orm": {
                "Fix issues with SubDecisions.": "https://raw.githubusercontent.com/GEWIS/orm/3.6.x/1-to-1-multiple-join-columns.patch"
            }
        },
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/GEWIS/gewisphp-coding-standards.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Migrations\\": "migrations/database/",
            "Report\\Migrations\\": "migrations/report/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "cp -r vendor/fortawesome/font-awesome/webfonts/. assets/fonts/fontawesome/",
            "rm -f assets/js/bootstrap.bundle.min.js",
            "cp vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js assets/js"
        ],
        "post-update-cmd": [
            "cp -r vendor/fortawesome/font-awesome/webfonts/. assets/fonts/fontawesome/",
            "rm -f assets/js/bootstrap.bundle.min.js",
            "cp vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js assets/js"
        ]
    }
}
