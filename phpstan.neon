includes:
    - phpstan/phpstan-baseline.neon

parameters:
    level: 6
    # Runtime guards check what the native signature allows, not what a docblock promises.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php

    # A ratchet rather than a baseline: the percentages are global, so a baseline entry stops matching the moment any
    # file is added or removed. Raise these as the gaps are closed; never lower them.
    type_coverage:
        param_type: 98
        return_type: 99
        property_type: 99
        constant_type: 0
