<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="GEWISDB Coding Standard">
    <arg name="basepath" value="." />
    <arg name="colors" />
    <arg name="error-severity" value="1" />
    <arg name="extensions" value="php,dist" />
    <arg name="parallel" value="75" />
    <arg name="warning-severity" value="1" />

    <arg value="nps" />

    <file>src</file>
    <file>config</file>

    <!-- Regenerated by the framework on every container build; not ours to style. -->
    <exclude-pattern>config/reference.php</exclude-pattern>

    <rule ref="GEWISPHPCodingStandards" />

    <!-- Legacy code that cannot be easily changed, so ignore for now -->
    <rule ref="Squiz.NamingConventions.ValidVariableName.MemberNotCamelCaps">
        <exclude-pattern>src/Entity/Database/Decision.php</exclude-pattern>
        <exclude-pattern>src/Entity/Database/SubDecision.php</exclude-pattern>
        <exclude-pattern>src/Entity/Database/MailingList.php</exclude-pattern>
        <exclude-pattern>src/Entity/Report/Decision.php</exclude-pattern>
        <exclude-pattern>src/Entity/Report/MailingList.php</exclude-pattern>
        <exclude-pattern>src/Entity/Report/SubDecision.php</exclude-pattern>
        <!-- Stripe also does this, so ignore those too -->
        <exclude-pattern>src/Service/Database/StripeService.php</exclude-pattern>
    </rule>

    <!-- Overrides that provide stricter typing -->
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod.Found">
        <exclude-pattern>src/ViewModel/Checker/Error/AnnulmentOfAnnulment.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/AnnulmentOfLaterDecision.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/DecisionAnnulledMoreThanOnce.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/MemberActiveAndInactiveInOrgan.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/MemberActiveWithRoleAndInactiveInOrgan.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/MemberExpiredButStillInOrgan.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/MemberInNonExistingOrgan.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/MemberInactiveInOrganWithoutInactiveMembers.php</exclude-pattern>
        <exclude-pattern>src/ViewModel/Checker/Error/OrganWithoutChair.php</exclude-pattern>
    </rule>
</ruleset>
