# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Fake-but-parseable values so the test kernel can compile without the development stack. Locally the compose files
# inject the real ones, which take precedence over anything written here; CI runs a PostgreSQL service on 127.0.0.1.
# The `when@test` doctrine configuration isolates both connections onto their own `_test` databases.
DATABASE_DSN='postgresql://gewisdb:gewisdb@127.0.0.1:5432/gewisdb?serverVersion=16&charset=utf8'
REPORT_DATABASE_DSN='postgresql://gewisdb:gewisdb@127.0.0.1:5432/gewisdb_report?serverVersion=16&charset=utf8'
