{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Delete Mailing List'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    {# The Laminas view also carried the "deleted" outcome; that is a flash message on the overview now. #}
    <h1>{{ 'Delete Mailing List'|trans }}</h1>
    <p>{{ 'Are you sure that you want to delete the %name% mailing list?'|trans({'%name%': name}) }}</p>
    {{ form_start(form) }}
        <div class="d-flex gap-2">
            {{ form_widget(form.submit_yes, {'attr': {'class': 'btn btn-danger'}}) }}
            {{ form_widget(form.submit_no, {'attr': {'class': 'btn btn-secondary'}}) }}
        </div>
    {{ form_end(form) }}
{% endblock %}
