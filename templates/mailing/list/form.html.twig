{% extends 'layout-sidebar.html.twig' %}

{% set title = null is same as(list) ? 'Add New Mailing List'|trans : 'Edit Mailing List'|trans %}

{% block page_title %}{{ title }} - {{ parent() }}{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-lg-8">
            <h1>{{ title }}</h1>
            {{ form_start(form) }}
                {# The name is the mailing list's identity, both here and in Listmonk/Mailman, so an existing list
                   only shows it. #}
                {{ form_row(form.name, null is same as(list) ? {} : {'attr': {'readonly': 'readonly'}}) }}
                {{ form_row(form.nl_description) }}
                {{ form_row(form.en_description) }}
                {{ form_row(form.onForm) }}
                {{ form_row(form.defaultSub) }}
                {# Mailman is on its way out: a list can still be shown and unbound, but a new binding is not offered. #}
                {% if form.mailmanList.vars.value is not empty %}
                    {{ form_row(form.mailmanList) }}
                {% else %}
                    {% do form.mailmanList.setRendered %}
                {% endif %}
                {{ form_row(form.listmonkList) }}
                {{ form_widget(form.submit, {'label': title, 'attr': {'class': 'btn-gewis-primary'}}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
