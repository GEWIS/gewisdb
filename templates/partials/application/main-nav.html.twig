{% macro item(href, label, active, badge) %}
    <li class="nav-item">
        <a class="nav-link{{ active ? ' active' : '' }}" href="{{ href }}"
           {% if active %}aria-current="page"{% endif %}>
            {{ label }}
            {% if badge|default(0) > 0 %}
                <span class="badge text-bg-light">{{ badge }}</span>
            {% endif %}
        </a>
    </li>
{% endmacro %}

{% import _self as menu %}

{# Route names are the handle for the active state; the Laminas view helper matched on controller and action, which
   no longer exist as a concept. #}
{% set route = app.current_route ?? '' %}

<nav class="navbar navbar-expand-lg navbar-gewis" aria-label="{{ 'Main navigation'|trans }}">
    <div class="container">
        <a class="navbar-brand" href="{{ path('application_home') }}">
            <span class="gi gewis-base" aria-hidden="true"></span>
            <span class="visually-hidden">GEWIS</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar"
                aria-controls="main-navbar" aria-expanded="false" aria-label="{{ 'Toggle Navigation'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-navbar">
            {% if null !== app.user %}
                <ul class="navbar-nav me-auto">
                    {{ menu.item(
                        path('application_home'),
                        'Home'|trans,
                        'application_home' == route,
                        notification_count(),
                    ) }}
                    {{ menu.item(
                        path('decision_meeting_index'),
                        'Meetings and Decisions'|trans,
                        route starts with 'decision_meeting',
                    ) }}
                    {{ menu.item(
                        path('decision_organ_index'),
                        'Organ'|trans,
                        route starts with 'decision_organ',
                    ) }}
                    {{ menu.item(
                        path('join_prospective_member_index'),
                        'Prospective Members'|trans,
                        route starts with 'join_prospective_member',
                    ) }}
                    {{ menu.item(
                        path('member_index'),
                        'Members'|trans,
                        route starts with 'member_',
                    ) }}
                    {{ menu.item(
                        path('decision_export_index'),
                        'Decision List'|trans,
                        route starts with 'decision_export',
                    ) }}
                    {{ menu.item(
                        path('query_index'),
                        'Query'|trans,
                        route starts with 'query_',
                    ) }}
                    {{ menu.item(
                        path('application_settings_index'),
                        'Settings'|trans,
                        route starts with 'application_settings',
                    ) }}
                </ul>
            {% endif %}
            {# Who you are, then a rule, then the settings menu — the order GEWISWEB uses. #}
            <ul class="navbar-nav ms-auto">
                {% if null !== app.user %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="fas fa-user" aria-hidden="true"></span>
                            {{ app.user.getName }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('user_logout') }}">
                                    <span class="fas fa-arrow-right-from-bracket" aria-hidden="true"></span>
                                    {{ 'Log out'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('user_login') }}">
                            <span class="fas fa-arrow-right-to-bracket" aria-hidden="true"></span>
                            {{ 'Log in'|trans }}
                        </a>
                    </li>
                {% endif %}
                <li class="nav-item py-4">
                    <div class="vr d-flex h-100 mx-2 text-white"></div>
                </li>
                {% include 'partials/application/language-switcher.html.twig' %}
            </ul>
        </div>
    </div>
</nav>
