{#
    The create and the edit screen post the same ApiPrincipalType; only the label on the submit button differs.

    {% include 'partials/user/api-principal-form.html.twig' with {
        'form': form,
        'submit_label': 'Save'|trans,
    } only %}

    - form          the ApiPrincipalType view
    - submit_label  optional; overrides the label the form type puts on its submit button
#}
{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.description) }}
    {# The token is generated by the application and is never read back from input, so there is nothing to show until
       the principal exists. Marking the field rendered keeps form_end() from emitting a stray empty input. #}
    {% if form.token.vars.value is not empty %}
        {{ form_row(form.token, {
            'help': 'Only the last characters of the token are shown; the token cannot be changed.'|trans,
        }) }}
    {% else %}
        {% do form.token.setRendered %}
    {% endif %}
    {# The footnote marks the permissions whose label carries a ¹. #}
    {{ form_row(form.permissions, {
        'help': '¹ This permission will add more properties to existing entities that can already be requested.'|trans,
    }) }}
    <div class="d-flex justify-content-end">
        {{ form_widget(form.submit, submit_label is defined ? {'label': submit_label} : {}) }}
    </div>
{{ form_end(form) }}
