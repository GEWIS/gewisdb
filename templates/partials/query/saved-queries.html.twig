{# Stored queries, grouped under their category. Grouping first rather than opening and closing a list as the
   category changes does not depend on the order the queries come back in. #}
{% set grouped = {} %}
{% for saved_query in saved_queries %}
    {% set category = saved_query.category|default('') is empty ? 'No category'|trans : saved_query.category %}
    {% set grouped = grouped|merge({(category): grouped[category]|default([])|merge([saved_query])}) %}
{% endfor %}

{% if grouped is not empty %}
    {% for category, queries in grouped %}
        <span class="stored-queries-group">{{ category }}</span>
        {% for saved_query in queries %}
            {# Opening a stored query is a page load rather than a client-side fill, so what is running is always the
               query the address names. #}
            <a class="stored-query{{ saved_query.id == (current_query_id|default(null)) ? ' active' : '' }}"
               href="{{ path('query_show', {'query': saved_query.id}) }}">
                <span class="fas fa-code stored-query-icon" aria-hidden="true"></span>
                {{ saved_query.name }}
            </a>
        {% endfor %}
    {% endfor %}
{% else %}
    {{ 'There are no saved queries.'|trans }}
{% endif %}
