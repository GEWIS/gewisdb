{% extends 'email/_base.html.twig' %}

{% block emailTitle %}Action Required to Complete GEWIS Registration{% endblock %}
{% block preheader %}{% endblock %}
{% block heading %}Update on your registration{% endblock %}
{% block subheading %}Payment Failed{% endblock %}
{% block body %}
    <p>Dear {{ firstName }},</p>
    <p>
        Your payment of the membership fee has failed. Without payment of the membership fee, we cannot approve the
        membership. We kindly ask you to try again using the following link:
        <a href="{{ restartUrl }}" style="color: #C40000; text-decoration: none;" target="_blank" rel="noopener nofollow">{{ restartUrl }}</a>.
    </p>
    {% include 'partials/email/payment-alternatives.html.twig' %}
    <p>
        With kind regards,
        <br>The board of GEWIS
    </p>
{% endblock %}
{% block footerNote %}You received this email because your membership fee payment failed.{% endblock %}
