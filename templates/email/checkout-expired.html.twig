{% extends 'email/_base.html.twig' %}

{% block emailTitle %}Action Required to Complete GEWIS Registration{% endblock %}
{% block preheader %}{% endblock %}
{% block heading %}Update on your registration{% endblock %}
{% block subheading %}Forgot to pay?{% endblock %}
{% block body %}
    <p>Dear {{ firstName }},</p>
    <p>
        We have noticed that you have not yet paid the one-time membership fee. Without the payment we cannot approve your
        membership. You can use the following link to start again:
        <a href="{{ restartUrl }}" style="color: #C40000; text-decoration: none;" target="_blank" rel="noopener nofollow">{{ restartUrl }}</a>.
    </p>
    {% include 'partials/email/payment-alternatives.html.twig' %}
    <p>
        With kind regards,
        <br>The board of GEWIS
    </p>
{% endblock %}
{% block footerNote %}You received this email because you have not yet paid the membership fee. This is a one-time mailing to ask you to do so.{% endblock %}
