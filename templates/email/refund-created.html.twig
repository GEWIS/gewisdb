{% extends 'email/_base.html.twig' %}

{% block emailTitle %}GEWIS Membership Fee Refund Issued{% endblock %}
{% block preheader %}{% endblock %}
{% block heading %}Update on your registration{% endblock %}
{% block subheading %}Refund of Membership Fee{% endblock %}
{% block body %}
    <p>Dear {{ firstName }},</p>
    <p>
        Your payment of the membership fee is being refunded. It can take anywhere from 5-10 business days to show up on
        your bank account.
    </p>
    <p>
        With kind regards,
        <br>The board of GEWIS
    </p>
{% endblock %}
{% block footerNote %}You received this email because your membership fee is being refunded.{% endblock %}
