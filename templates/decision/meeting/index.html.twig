{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Meetings'|trans }} - {{ parent() }}{% endblock %}

{# Every cell of a row leads to the same meeting; a block-level anchor keeps the whole cell clickable, which the
   Laminas view achieved with an inline width/height style. #}
{% macro cell(url, value) %}
    <td><a class="d-block text-body text-decoration-none" href="{{ url }}">{{ value }}</a></td>
{% endmacro %}

{% import _self as meetings_table %}

{% block contents %}
    <div class="d-flex justify-content-between align-items-start mb-3">
        <h1>{{ 'Meetings'|trans }}</h1>
        <a href="{{ path('decision_meeting_create') }}" class="btn btn-success">
            {{ 'Add New Meeting'|trans }}
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">{{ 'Type'|trans }}</th>
                    <th scope="col">{{ 'Meeting Number'|trans }}</th>
                    <th scope="col">{{ 'Meeting Date'|trans }}</th>
                    <th scope="col">{{ '# Decisions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in meetings %}
                    {% set url = path('decision_meeting_view', {
                        'type': row.meeting.type.value,
                        'number': row.meeting.number,
                    }) %}
                    <tr>
                        {{ meetings_table.cell(url, row.meeting.type.value) }}
                        {{ meetings_table.cell(url, row.meeting.number) }}
                        {{ meetings_table.cell(url, row.meeting.date|format_date('full')) }}
                        {{ meetings_table.cell(url, row.decisionCount) }}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-secondary">{{ 'There are no meetings yet.'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
