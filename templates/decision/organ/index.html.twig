{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Bodies'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Bodies'|trans }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_title %}{{ 'Bodies'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Committees and fraternities, each traced back to the decision that founded it.'|trans }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    {{ component('Database:BodyOverview') }}
{% endblock %}
