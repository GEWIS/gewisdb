{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ member.fullName }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('member_index') }}">{{ 'Members'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ member.fullName }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_status %}
            <div class="page-header-meta"><span class="badge badge-secondary">{{ 'Deleted'|trans }}</span></div>
        {% endblock %}
        {% block header_title %}{{ member.fullName }}{% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="panel">
        <div class="panel-body">
            {% include 'partials/application/empty-state.html.twig' with {
                icon: 'fa-user-slash',
                title: 'This member has been deleted'|trans,
                body: 'Only their name is kept, so that the decisions mentioning them stay correct. There is nothing here to edit.'|trans,
            } only %}
        </div>
    </div>
{% endblock %}
