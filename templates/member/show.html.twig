{% extends 'layout-sidebar.html.twig' %}
{% import 'partials/member/labels.html.twig' as labels %}

{% block page_title %}{{ member.fullName }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('member_index') }}">{{ 'Members'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ member.fullName }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_status %}
            {% include 'partials/member/status-badge.html.twig' with {member: member} only %}
        {% endblock %}
        {% block header_title %}{{ member.fullName }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Member %number% · Generation %generation% · Expires %expiration%'|trans({
                    '%number%': member.lidnr,
                    '%generation%': member.generation,
                    '%expiration%': member.expiration|format_date(pattern: 'd MMMM y'),
                }) }}
            </p>
        {% endblock %}
        {% block header_actions %}
            {% if can_change_membership_type %}
                <a class="btn btn-outline-gewis-primary"
                   href="{{ path('member_membership_edit', {lidnr: member.lidnr}) }}">
                    <span class="fas fa-rotate" aria-hidden="true"></span>
                    {{ 'Update / Renew'|trans }}
                </a>
            {% endif %}
            <a class="btn btn-gewis-primary" href="{{ path('member_edit', {lidnr: member.lidnr}) }}">
                <span class="fas fa-pen" aria-hidden="true"></span>
                {{ 'Change Data'|trans }}
            </a>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="row g-3">
        <div class="col-12 col-xl-8">

            <div class="panel">
                <div class="panel-heading"><h3>{{ 'Member record'|trans }}</h3></div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row">{{ 'Member Number'|trans }}</th>
                                    <td>{{ member.lidnr }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Initial(s)'|trans }}</th>
                                    <td>{{ member.initials }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'First Name'|trans }}</th>
                                    <td>{{ member.firstName }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Last Name Prepositional Particle'|trans }}</th>
                                    <td>{{ member.middleName }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Last Name'|trans }}</th>
                                    <td>{{ member.lastName }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'TU/e student number'|trans }}</th>
                                    <td>{{ member.studentNumber ?? 'Unknown'|trans }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'E-mail Address'|trans }}</th>
                                    <td>
                                        {% if null is not same as(member.email) %}
                                            <a href="mailto:{{ member.email }}">{{ member.email }}</a>
                                        {% else %}
                                            <span class="text-secondary">{{ 'Unknown'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Birthdate'|trans }}</th>
                                    <td>{{ member.birth|format_date(pattern: 'EEEE d MMMM y') }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Generation'|trans }}</th>
                                    <td>{{ member.generation }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Paid for current/last membership (Amount)'|trans }}</th>
                                    <td>
                                        {{- null is same as(member.currentOrLastMembership)
                                            ? ''
                                            : member.currentOrLastMembership.paid -}}
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Membership Type (today)'|trans }}</th>
                                    <td>
                                        {{ labels.membership_type(
                                            null is same as(member.currentMembership)
                                                ? null
                                                : member.currentMembership.type,
                                        ) }}
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Study'|trans }}</th>
                                    {# `getName()` spelled out: `member.study.name` resolves to the enum case name. #}
                                    <td>{{ member.study.getName|trans }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Last Update to Membership'|trans }}</th>
                                    <td>{{ member.changedOn|format_date(pattern: 'EEEE d MMMM y') }}</td>
                                </tr>
                                <tr>
                                    <th scope="row">{{ 'Membership Ends On (Expires On)'|trans }}</th>
                                    <td>
                                        {{ null is same as(membership_ends_on)
                                            ? 'n/a'|trans
                                            : membership_ends_on|format_date(pattern: 'EEEE d MMMM y') }}
                                        ({{ member.expiration|format_date(pattern: 'EEEE d MMMM y') }})
                                        {% if can_extend %}
                                            <a href="{{ path('member_expiration_edit', {lidnr: member.lidnr}) }}"
                                               class="btn btn-sm btn-outline-gewis-primary ms-2">
                                                {{ 'Extend'|trans }}
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Membership of Committees and Fraternities'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if has_correct_installations and organs is not empty %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for organ in organs %}
                                <a href="{{ organ.url }}" class="badge badge-gewis-primary text-decoration-none">
                                    {{ organ.abbr }}
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-secondary mb-0">{{ 'This member is not installed in a body.'|trans }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="panel border-danger">
                <div class="panel-body d-flex flex-wrap align-items-center gap-3">
                    <span class="flex-grow-1">
                        <span class="d-block fw-semibold">{{ 'Destructive actions'|trans }}</span>
                        <span class="text-secondary small">
                            {{ 'Deleting a member removes their record and their body history. Letting the membership expire is almost always what you want instead.'|trans }}
                        </span>
                    </span>
                    <a href="{{ path('member_delete', {lidnr: member.lidnr}) }}" class="btn btn-sm btn-outline-danger">
                        {{ 'Delete Member'|trans }}
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">

            <div class="panel">
                <div class="panel-heading"><h3>{{ 'Addresses'|trans }}</h3></div>
                <div class="panel-body">
                    {% for address in member.addresses %}
                        {% include 'partials/member/address-card.html.twig' %}
                    {% else %}
                        <p class="text-secondary">{{ 'No addresses on record.'|trans }}</p>
                    {% endfor %}

                    {# Only the address types the member does not have yet can be added. #}
                    {% set present = member.addresses|map(address => address.type.value) %}
                    {% set addable = {
                        'home': 'Add Home Address',
                        'student': 'Add Student Address',
                        'mail': 'Add Mail Address',
                    } %}
                    {% set missing = addable|filter((text, key) => key not in present) %}
                    {% if missing is not empty %}
                        {# Vertical, because the column is narrow and these labels are long enough that a row of them
                           would not fit across it. #}
                        <div class="btn-group-vertical btn-group-sm w-100" role="group"
                             aria-label="{{ 'Add an address'|trans }}">
                            {% for type, label in missing %}
                                <a href="{{ path('member_address_add', {lidnr: member.lidnr, type: type}) }}"
                                   class="btn btn-outline-gewis-primary">
                                    <span class="fas fa-plus" aria-hidden="true"></span>
                                    {{ label|trans }}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading"><h3>{{ 'Mailing List Subscriptions'|trans }}</h3></div>
                <div class="panel-body">
                    <ul class="list-unstyled mb-3">
                        {% for subscription in member.mailingListMemberships|filter(s => not s.isToBeDeleted) %}
                            <li class="d-flex align-items-center gap-2">
                                <span class="fas fa-circle-check text-success" aria-hidden="true"></span>
                                {{ subscription.mailingList.name }}
                            </li>
                        {% else %}
                            <li class="text-secondary">{{ 'No mailing list subscriptions.'|trans }}</li>
                        {% endfor %}
                    </ul>
                    <a href="{{ path('member_lists_edit', {lidnr: member.lidnr}) }}"
                       class="btn btn-sm btn-outline-gewis-primary">
                        {{ 'Change Mailing List Subscriptions'|trans }}
                    </a>
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading"><h3>{{ 'Supremum'|trans }}</h3></div>
                <div class="panel-body">
                    <p class="mb-3">
                        {% if 'optin' == member.supremum %}
                            <span class="fas fa-circle-check text-success me-1" aria-hidden="true"></span>
                            {{ 'Wants to receive the Supremum.'|trans }}
                        {% elseif 'optout' == member.supremum %}
                            <span class="fas fa-circle-xmark text-secondary me-1" aria-hidden="true"></span>
                            {{ 'Does not want to receive the Supremum.'|trans }}
                        {% else %}
                            <span class="fas fa-circle-question text-secondary me-1" aria-hidden="true"></span>
                            {{ 'Has not said whether they want the Supremum.'|trans }}
                        {% endif %}
                    </p>

                    {# Setting the preference changes the member, so each answer is posted rather than linked. The
                       three answers are three routes, and one form reaches all of them through `formaction`; a form
                       apiece would put three separate buttons here instead of one group. They share a token because
                       they share the check that guards them. #}
                    <form method="post" action="{{ path('member_supremum_reset', {lidnr: member.lidnr}) }}">
                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('member_supremum-' ~ member.lidnr) }}">
                        <div class="btn-group btn-group-sm" role="group"
                             aria-label="{{ 'Wants to Receive Supremum'|trans }}">
                            {% for route, label in {
                                'member_supremum_optin': 'Opt in',
                                'member_supremum_optout': 'Opt out',
                                'member_supremum_reset': 'Reset',
                            } %}
                                <button type="submit" class="btn btn-outline-gewis-primary"
                                        formaction="{{ path(route, {lidnr: member.lidnr}) }}">
                                    {{ label|trans }}
                                </button>
                            {% endfor %}
                        </div>
                    </form>
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading"><h3>{{ 'Notes'|trans }}</h3></div>
                <div class="panel-body">
                    {% for note in notes %}
                        <div class="member-note">
                            {# Safe to print unescaped: AuditEntryRow escapes the arguments before interpolating them
                               into the entry's own format string, which is what carries the markup. #}
                            <p class="mb-1">{{ note.body|raw }}</p>
                            <p class="small text-secondary mb-0">
                                {{ note.user }} · {{ note.updatedAt|date('j M Y H:i') }}
                            </p>
                        </div>
                    {% else %}
                        <p class="text-secondary">
                            {{ 'There are no notes for this member.'|trans }}
                        </p>
                    {% endfor %}

                    {# The note form posts back to this page, which is where the audit trail lives. #}
                    {{ form_start(note_form) }}
                        <div class="input-group input-group-sm">
                            {{ form_widget(note_form.note, {attr: {
                                placeholder: note_form.note.vars.label|trans,
                            }}) }}
                            {{ form_widget(note_form.submit, {attr: {class: 'btn-gewis-primary'}}) }}
                        </div>
                        {{ form_errors(note_form.note) }}
                    {{ form_end(note_form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
