{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Mailing List Subscriptions'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('member_index') }}">{{ 'Members'|trans }}</a></li>
    <li class="breadcrumb-item">
        <a href="{{ path('member_show', {lidnr: member.lidnr}) }}">{{ member.fullName }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Mailing Lists'|trans }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_top %}
            <span class="page-header-eyebrow">{{ 'Member'|trans }}</span>
        {% endblock %}
        {% block header_title %}{{ 'Mailing List Subscriptions'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ member.fullName }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="panel">
                <div class="panel-body">
                    {{ form_start(form) }}
                    {# `MemberListsType` spells out the pending sync state in each label and locks the subscriptions
                       that are still waiting on it, so the checkboxes need nothing beyond the form theme. #}
                    {{ form_row(form.lists, {label: false}) }}
                    {{ form_widget(form.submit, {attr: {class: 'btn-gewis-primary'}}) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
