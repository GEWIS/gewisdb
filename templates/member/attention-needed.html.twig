{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Members requiring attention'|trans }} - {{ parent() }}{% endblock %}

{#
    `rows` pairs each member with the `AttentionReasons` they turned up under; the reason renders its own label and
    recommended action.

    `bulk_renewal_shortcuts` holds the membership numbers behind the two shortcuts, which prefill the bulk renewal
    form; producing that preview reads nothing and changes nothing, so it is a link rather than a post.
#}
{% macro shortcut(member_ids, membership_type, label) %}
    {% if member_ids is empty %}
        <span class="btn btn-gewis-primary disabled" aria-disabled="true">{{ label }}</span>
    {% else %}
        <a class="btn btn-gewis-primary"
           href="{{ path('member_bulk_renewal_index', {
               memberIds: member_ids|join(' '),
               membershipType: membership_type,
           }) }}">
            {{ label }}
        </a>
    {% endif %}
{% endmacro %}

{% import _self as bulk %}

{% block contents %}
    <h1>{{ 'Members requiring attention'|trans }}</h1>

    <p>
        {{ 'The following members require attention because their membership will expire within the next %days% days or they are missing required information.'|trans({
            '%days%': days,
        }) }}
    </p>
    <p>
        {{ 'Bulk renewal is available for expiring active members and bulk conversion to graduate available for expiring non-active members. Do this <strong>after</strong> studying members have been renewed.'|trans|raw }}
    </p>

    <div class="d-flex flex-wrap gap-2 mb-3">
        {{ bulk.shortcut(
            bulk_renewal_shortcuts.expiring_active,
            'external',
            'Renew expiring active members'|trans,
        ) }}
        {{ bulk.shortcut(
            bulk_renewal_shortcuts.expiring_non_active,
            'graduate',
            'Convert expiring non-active members to graduate'|trans,
        ) }}
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">{{ 'Membership number'|trans }}</th>
                    <th scope="col">{{ 'Name'|trans }}</th>
                    <th scope="col">{{ 'Expiration'|trans }}</th>
                    <th scope="col">{{ 'Reason(s)'|trans }}</th>
                    <th scope="col">{{ 'Typical action'|trans }}</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    {% set member_url = path('member_show', {lidnr: row.member.lidnr}) %}
                    {% for reason in row.reasons %}
                        <tr>
                            {# The member is stated once and spans all of their reasons. #}
                            {% if loop.first %}
                                <td rowspan="{{ row.reasons|length }}">
                                    <a href="{{ member_url }}">{{ row.member.lidnr }}</a>
                                </td>
                                <td rowspan="{{ row.reasons|length }}">
                                    <a href="{{ member_url }}">{{ row.member.fullName }}</a>
                                </td>
                                <td rowspan="{{ row.reasons|length }}">
                                    {{ row.member.expiration|date('Y-m-d') }}
                                </td>
                            {% endif %}
                            <td>{{ reason|trans }}</td>
                            <td>{{ reason.recommendedAction|trans }}</td>
                            <td class="text-nowrap">
                                {% if reason.renewRecommended %}
                                    <a class="btn btn-sm btn-gewis-primary" target="_blank" rel="noopener"
                                       href="{{ path('member_membership_edit', {lidnr: row.member.lidnr}) }}">
                                        {{ 'Renew/Type'|trans }}
                                    </a>
                                {% endif %}
                                {% if reason.editRecommended %}
                                    <a class="btn btn-sm btn-gewis-primary" target="_blank" rel="noopener"
                                       href="{{ path('member_edit', {lidnr: row.member.lidnr}) }}">
                                        {{ 'Edit'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="6" class="text-secondary">
                            {{ 'No members require attention.'|trans }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
