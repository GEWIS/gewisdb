{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Change Data'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('member_index') }}">{{ 'Members'|trans }}</a></li>
    <li class="breadcrumb-item">
        <a href="{{ path('member_show', {lidnr: member.lidnr}) }}">{{ member.fullName }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Change Data'|trans }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_top %}
            <span class="page-header-eyebrow">{{ 'Member'|trans }}</span>
        {% endblock %}
        {% block header_title %}{{ 'Change Data'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ member.fullName }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-body">
                    {{ form_start(form) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.middleName) }}
                    {{ form_row(form.initials) }}
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.studentNumber) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.study) }}
                    {{ form_row(form.birth) }}
                    {{ form_row(form.hidden) }}
                    {{ form_widget(form.submit, {attr: {class: 'btn-gewis-primary'}}) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
