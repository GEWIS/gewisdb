{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Change Data'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    <h1>{{ 'Change Data of %name%'|trans({'%name%': member.fullName}) }}</h1>

    <div class="row">
        <div class="col-md-6">
            {{ form_start(form) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.middleName) }}
            {{ form_row(form.initials) }}
            {{ form_row(form.firstName) }}
            {{ form_row(form.studentNumber) }}
            {{ form_row(form.email) }}
            {{ form_row(form.study) }}
            {{ form_row(form.birth) }}
            {{ form_row(form.hidden) }}
            {{ form_widget(form.submit, {attr: {class: 'btn-gewis-primary'}}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
