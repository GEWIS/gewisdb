{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Create user'|trans }} - {{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('application_settings_index') }}">{{ 'Settings'|trans }}</a>
    </li>
    <li class="breadcrumb-item"><a href="{{ path('user_index') }}">{{ 'Users'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Create'|trans }}</li>
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_title %}{{ 'Create user'|trans }}{% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <div class="panel">
                <div class="panel-body">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.login) }}
                        {# The password is a RepeatedType; rendering both halves directly avoids the extra fieldset
                           and the duplicate label that come with rendering the pair as one row. #}
                        {{ form_row(form.password.password) }}
                        {{ form_row(form.password.password_verify) }}
                        <div class="d-flex justify-content-end">
                            {{ form_widget(form.submit, {attr: {class: 'btn-gewis-primary'}}) }}
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
