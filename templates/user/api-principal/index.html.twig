{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'API principals'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-12">
            <h1>{{ 'API principals'|trans }}</h1>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">{{ 'Description'|trans }}</th>
                            <th scope="col">{{ 'Permissions'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Edit / Delete'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for principal in principals %}
                            <tr>
                                <td>{{ principal.id }}</td>
                                <td>{{ principal.description }}</td>
                                <td>
                                    <ul class="list-unstyled mb-0">
                                        {% for permission in principal.permissions %}
                                            <li>{{ permission|trans }}</li>
                                        {% endfor %}
                                    </ul>
                                </td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a class="btn btn-warning btn-sm"
                                           href="{{ path('user_api_principal_edit', {'id': principal.id}) }}">
                                            {{ 'Edit'|trans }}
                                        </a>
                                        {# An icon-only button carried no accessible name; the actions are spelled out
                                           now that the glyphicon set is gone. #}
                                        <form method="post"
                                              action="{{ path('user_api_principal_delete', {'id': principal.id}) }}">
                                            <input type="hidden" name="_csrf_token"
                                                   value="{{ csrf_token('api_principal_delete-' ~ principal.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                {{ 'Delete'|trans }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-secondary py-4">
                                    {{ 'There are no API principals yet.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <a href="{{ path('user_api_principal_create') }}" class="btn btn-success">
                {{ 'Create new API principal'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
