{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Users'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-12">
            <h1>{{ 'Users'|trans }}</h1>

            {% if uses_ldap %}
                <div class="alert alert-danger" role="alert">
                    {# The link used to be spliced into the translated sentence with sprintf; keeping it as its own
                       element means no message in the catalogue carries markup. #}
                    <strong>{{ 'Warning:'|trans }}</strong>
                    {{ 'The database currently requires the usage of GEWIS m-accounts to log in. Any accounts created here cannot be used to log in.'|trans }}
                    <a href="https://support.gewis.nl/kb/faq.php?id=36" target="_blank" rel="noopener">
                        {{ 'Learn more about m-accounts.'|trans }}
                    </a>
                </div>
            {% endif %}

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">{{ 'Username'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Edit / Delete'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.login }}</td>
                                <td class="text-end">
                                    <a class="btn btn-gewis-primary btn-sm" href="{{ path('user_edit', {'id': user.id}) }}">
                                        {{ 'Edit / Delete'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-secondary py-4">
                                    {{ 'There are no users yet.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <a href="{{ path('user_create') }}" class="btn btn-success">
                {{ 'Add new user'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
