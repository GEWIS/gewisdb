{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ user.login }} - {{ 'Users'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <h1>{{ 'Change password for %login%'|trans({'%login%': user.login}) }}</h1>

            {% if not user.local %}
                {# The form keeps the fields but disables them for such an account; without this the disabled inputs
                   look like a bug. #}
                <div class="alert alert-info" role="alert">
                    {{ 'This account signs in through an external directory, so there is no password to change here.'|trans }}
                </div>
            {% endif %}

            {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.password.password) }}
                {{ form_row(form.password.password_verify) }}
                <div class="d-flex justify-content-end">
                    {{ form_widget(form.submit) }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8 col-lg-6">
            <h2>{{ 'Delete %login%'|trans({'%login%': user.login}) }}</h2>

            <form method="post" action="{{ path('user_delete', {'id': user.id}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('user_delete-' ~ user.id) }}">
                <button type="submit" class="btn btn-danger">
                    {{ 'Delete User'|trans }}
                </button>
            </form>
        </div>
    </div>
{% endblock %}
