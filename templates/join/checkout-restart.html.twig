{% extends 'join/base.html.twig' %}

{% set nav_title = 'GEWIS Registration - Checkout'|trans %}

{% block page_title %}{{ 'GEWIS Registration - Checkout'|trans }} - {{ parent() }}{% endblock %}

{% block contents %}
    {% embed 'partials/join/registration-header.html.twig' %}
        {% block registration_intro %}
            <p>{{ 'Checkout'|trans }}</p>
        {% endblock %}
    {% endembed %}

    {% if error %}
        <div class="alert alert-danger" role="alert">
            <strong>{{ 'Oh snap!'|trans }}</strong>
            {{ 'An error occurred while we were trying to prepare the checkout page. Please try again later.'|trans }}
        </div>
    {% else %}
        <p>
            {{ 'This payment link could not be found. Perhaps it has been used before or has expired.'|trans }}
        </p>
    {% endif %}
{% endblock %}
