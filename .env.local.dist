# Copy to `.env.local` and fill in. These are the values that cannot be committed; everything else has a
# development default in `.env`.

APP_SECRET=

# A restricted Stripe key with write on Charges and Refunds, Payment Links and Checkout Sessions.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_KEY=
STRIPE_MEMBERSHIP_PRICE_ID=

# Only needed to send through the production relay; development catches mail in Mailpit instead.
SMTP_PASSWORD=

# Only needed to sign in through the GEWIS directory; development uses a local account.
LDAP_BINDUSER_PASS=
