# Copy to `.env.local` and fill in. These are the values that cannot be committed; everything else has a
# development default in `.env`.
#
# Docker compose is given this file as well as `.env` (see the Makefile), so these reach the containers that need
# them — the Stripe CLI among them — as well as the application.

APP_SECRET=

# Stripe
#
# The key should at all times be a restricted key with write on "Core Objects: Charges and Refunds",
# "Payment Links: *" and "Checkout Sessions: Checkout Sessions". Add "Stripe CLI: *" to use `stripe trigger`, which
# creates a product and a price to fire an event against; without it the CLI answers 403 and the trigger fails while
# `listen` keeps working.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_MEMBERSHIP_PRICE_ID=

# The `stripe` container runs `stripe listen` and forwards events to the application, which refuses any event whose
# signature does not verify against this secret. The CLI mints its own secret, so take it from the running container
# and put it here:
#
#     make stripewebhooksecret
#
# Then recreate the web container (`make up`) so it picks the new value up. A mismatch is silent from the outside:
# the CLI reports the event as forwarded and the application answers 400 without recording anything.
STRIPE_WEBHOOK_SIGNING_KEY=

# Only needed to send through the production relay; development catches mail in Mailpit on http://localhost:8025.
SMTP_PASSWORD=

# Only needed to sign in through the GEWIS directory; development uses a local account.
LDAP_BINDUSER_PASS=
