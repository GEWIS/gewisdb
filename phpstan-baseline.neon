# Everything level 8 and the extra strictness rules report today, so the gate is green and the debt is visible.
#
# The bulk is three classes: `in_array()` without `$strict` (a loose comparison the disallowed-calls rules refuse),
# associations the mapping makes nullable but the application keeps non-null, and generics on repositories and
# collections that carry no type parameters.
#
# Shrink it; do not grow it.
parameters:
	ignoreErrors:
		-
			message: '#^Only booleans are allowed in a negated boolean, mixed given\.$#'
			identifier: booleanNot.exprNotBoolean
			count: 1
			path: src/Command/Database/DeleteExpiredMembersCommand.php

