# Development defaults for the whole stack, committed. Docker compose substitutes from this file, and Symfony reads
# it as the base of its dotenv chain.
#
# Production does not use it: the orchestrator sets the same names in the environment compose runs in, and those win.
#
# These are deliberately absent, so that nothing empty is injected over what `.env.local` sets: APP_SECRET, the
# STRIPE_* keys, SMTP_PASSWORD and LDAP_BINDUSER_PASS. They are listed in `.env.local.dist`.
#
# To change a value for yourself, put it in `.env.local` — not committed, created from `.env.local.dist` by
# `make start`. Symfony reads it over this file. Note that a name listed under `environment:` for the web service in
# docker-compose.yml is injected by compose and cannot be overridden that way; change it here instead.

# gewisdb specific env variables
DOCTRINE_DEFAULT_HOST=postgresql
DOCTRINE_DEFAULT_PORT=5432
DOCTRINE_DEFAULT_USER=gewisdb
DOCTRINE_DEFAULT_PASSWORD=gewisdb
DOCTRINE_DEFAULT_ROLE=gewisdb
DOCTRINE_DEFAULT_DATABASE=gewisdb
DOCTRINE_REPORT_HOST=postgresql
DOCTRINE_REPORT_PORT=5432
DOCTRINE_REPORT_USER=gewisdb
DOCTRINE_REPORT_PASSWORD=gewisdb
DOCTRINE_REPORT_ROLE=gewisdb
DOCTRINE_REPORT_DATABASE=gewisdb_report
POSTGRES_VERSION=16

# Composed from the parts above so a deployment keeps setting the individual values it already sets. The role is
# applied per connection by SetRoleDriver rather than through the DSN.
DATABASE_DSN="postgresql://${DOCTRINE_DEFAULT_USER}:${DOCTRINE_DEFAULT_PASSWORD}@${DOCTRINE_DEFAULT_HOST}:${DOCTRINE_DEFAULT_PORT}/${DOCTRINE_DEFAULT_DATABASE}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
REPORT_DATABASE_DSN="postgresql://${DOCTRINE_REPORT_USER}:${DOCTRINE_REPORT_PASSWORD}@${DOCTRINE_REPORT_HOST}:${DOCTRINE_REPORT_PORT}/${DOCTRINE_REPORT_DATABASE}?serverVersion=${POSTGRES_VERSION}&charset=utf8"

# The hosts Caddy answers on. `:9725` in development, the three public names in production.
SERVER_NAME=:9725

# Public domain for emails
APP_URL=https://member.gewis.nl

# Stripe settings to enable auto-magic payment flow in enrolment form
# The STRIPE_SECRET_KEY should at all times be a restricted key with the following permissions:
# Write on "Core Objects: Charges and Refunds", "Payment Links: *", and "Checkout Sessions: Checkout Sessions"
# For debugging you also want Write on "Stripe CLI: *"
# Stripe sends a `Stripe-Notice` header when the pinned version is behind, and the SDK re-raises it as a
# PHP warning, which the dev error handler turns into an exception. Keep this current. The installed SDK
# is built for 2026-06-24.dahlia; both are the same major, within which Stripe only adds.
STRIPE_API_VERSION=2026-07-29.dahlia
STRIPE_CANCEL_URL=https://database.test.gewis.nl/member/subscribe/checkout/cancelled?stripe_session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL=https://database.test.gewis.nl/member/subscribe/checkout/completed?stripe_session_id={CHECKOUT_SESSION_ID}

# Mail settings for production (postfix)
SMTP_SERVER=mail.gewis.nl
SMTP_PORT=587
SMTP_USERNAME=service-web@gewis.nl
SERVER_HOSTNAME=database.gewis.nl
# The two hosts that serve the public flows. Each may only reach the paths belonging to its flow; see
# HostFirewallListener.
JOIN_HOSTNAME=join.gewis.nl
MEMBER_HOSTNAME=member.gewis.nl

MAIL_FROM_ADDRESS=example@example.com
MAIL_FROM_NAME='Study Association GEWIS'
MAIL_FROM_SECRETARY_ADDRESS=example@example.com
MAIL_FROM_SECRETARY_NAME='Secretary of GEWIS'
MAIL_TO_CHECKER_RESULT_ADDRESS=example@example.com
MAIL_TO_CHECKER_RESULT_NAME='Secretary of GEWIS'
MAIL_TO_REPORT_ERROR_ADDRESS=example@example.com
MAIL_TO_REPORT_ERROR_NAME='Database Wizards'
MAIL_TO_SUBSCRIPTION_ADDRESS=example@example.com
MAIL_TO_SUBSCRIPTION_NAME='Secretary of GEWIS'

MAILMAN_API_ENDPOINT=http://mailman-core:8001/3.1/
MAILMAN_API_VERSION='3.1'
MAILMAN_API_USERNAME=restadmin
MAILMAN_API_PASSWORD=restpass

LISTMONK_API_ENDPOINT=http://listmonk:9000/api/
LISTMONK_API_USERNAME=listmonkapi
LISTMONK_API_PASSWORD=listmonkpwd

# LDAP settings (fill in to enable LDAP)
LDAP_SERVERS=ldaps.gewis.nl
LDAP_STARTTLS=true
LDAP_DOMAIN=GEWISWG.GEWIS.NL
LDAP_FILTER="(&(objectClass=user)(memberOf:1.2.840.113556.1.4.1941:=CN=PRIV - GEWISDB User,OU=Privileges,OU=Groups,DC=gewiswg,DC=gewis,DC=nl)(sAMAccountName=%s))"
LDAP_BINDUSER_USERNAME=svc-abcdef@gewiswg.gewis.nl
LDAP_BASEDN=

# These are the environment variables for Postgres, only used in docker-compose.override.yaml for development
POSTGRES_MAILMAN_DATABASE=gewisdb_mailman
POSTGRES_LISTMONK_DATABASE=gewisdb_listmonk
POSTGRES_PASSWORD=gewisdb
POSTGRES_USER=gewisdb
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_UPGRADE_CHECK_ENABLED=False
PGADMIN_CONFIG_USER_INACTIVITY_TIMEOUT=0
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=pgadmin
PGADMIN_DISABLE_POSTFIX=true

# This makes debugging with XDebug and PHPStorm easier
PHP_IDE_CONFIG=serverName=database.gewis.nl

# Demo mode credentials (this will prepopulate the credential fields with these values)
DEMO_CREDENTIALS_USERNAME=admin
DEMO_CREDENTIALS_PASSWORD=gewisdbgewis

# Timezone (incl Postfix)
TZ=Europe/Amsterdam
PGTZ=Europe/Amsterdam

###> symfony/framework-bundle ###
APP_ENV=dev
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/lock ###
# Advisory locks on the database we already run, rather than `flock`: the schedules are consumed by one container
# each, and during a rolling deploy the outgoing and incoming container both hold a worker for a moment. A per-
# container `flock` cannot see across that boundary, so both would dispatch the same run.
LOCK_DSN="postgresql+advisory://${DOCTRINE_DEFAULT_USER}:${DOCTRINE_DEFAULT_PASSWORD}@${DOCTRINE_DEFAULT_HOST}:${DOCTRINE_DEFAULT_PORT}/${DOCTRINE_DEFAULT_DATABASE}"
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://postfix:1025
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
